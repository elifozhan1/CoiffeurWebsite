@model CoiffeurWebsite.Models.Employee

@{
    ViewData["Title"] = "Create";
}

<h2>Create</h2>

<h4>Employee</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="EmployeeName" class="control-label">Employee Name</label>
                <input asp-for="EmployeeName" class="form-control" />
                <span asp-validation-for="EmployeeName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TreatmentID" class="control-label">Treatment</label>
                <select asp-for="TreatmentID" class ="form-control" asp-items="ViewBag.TreatmentID"></select>
            </div>
            <div class="form-group">
                <label asp-for="SalonID" class="control-label">Salon</label>
                <select asp-for="SalonID" class ="form-control" asp-items="ViewBag.SalonID"></select>
            </div>
            <hr style="border: 5px groove #ffafc9;">
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-secondary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
