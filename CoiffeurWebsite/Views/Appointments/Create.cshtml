@model CoiffeurWebsite.Models.Appointment

@{
    ViewData["Title"] = "Create";
}

<h1>Create Appointment</h1>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="AppointmentDate" class="control-label"></label>
        <input asp-for="AppointmentDate" class="form-control" id="appointment"/>
        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TreatmentID" class="control-label"></label>
        <select asp-for="TreatmentID" class="form-control" id="treatmentDropdown">
            @if (ViewBag.Treatments != null && ViewBag.Treatments.Count > 0){

                @foreach (var treatment in ViewBag.Treatments)
                {
                    <option value="@treatment.TreatmentID">@treatment.TreatmentName</option>
                }
            }
            else
            {
                <p>No treatments available.</p>
            }

        </select>
    </div>
    <div class="form-group">
        <label asp-for="EmployeeID" class="control-label"></label>
        <select asp-for="EmployeeID" class="form-control" id="employeeDropdown">
             @if (ViewBag.Treatments != null && ViewBag.Treatments.Count > 0)
             {
                @foreach (var employee in ViewBag.Employees)
                {
                    <option value="@employee.EmployeeID" data-treatment-id="@employee.TreatmentID">
                        @employee.EmployeeName
                    </option>
                }
             }
            else
            {
                <p>No employee available.</p>
            }
        </select>

        <hr style="border: 5px dotted #ffafc9;">
    </div>
    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-secondary" />
    </div>
</form>


@section Scripts {
    <script>
        $(document).ready(function () {
            $('#treatmentDropdown').change(function () {
                var selectedTreatmentId = $(this).val();
                $('#employeeDropdown option').each(function () {
                    var employeeTreatmentId = $(this).data('treatment-id');
                    if (employeeTreatmentId == selectedTreatmentId) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const appointment = document.getElementById('appointment');
            const treatmentDropdown = document.getElementById('treatmentDropdown');
            const employeeDropdown = document.getElementById('employeeDropdown');

            appointment.addEventListener('change', () => {
                const value = appointment.value;
                const selectedDate = new Date(value);
                const currentDate = new Date();

                // Geçmiş tarih kontrolü 
                if (selectedDate < currentDate) {
                    alert("Appointment cannot be scheduled in the past.");
                    appointment.value = ''; // Seçimi sıfırlar
                    return;
                }

                // Çalışma saatleri kontrolü
                const selectedHours = selectedDate.getHours();
                if (selectedHours < 9 || selectedHours >= 18) {
                    alert("Appointments must be scheduled between 09:00 and 18:00.");
                    appointment.value = ''; // Seçimi sıfırlar
                    return;
                }

                // Hafta sonu kontrolü
                const dayOfWeek = selectedDate.getDay();
                if (dayOfWeek === 0 || dayOfWeek === 6) {
                    alert("Appointments cannot be scheduled on weekends.");
                    appointment.value = ''; // Seçimi sıfırlar
                    return;
                }
            });

            treatmentDropdown.addEventListener('change', async () => {
                const selectedTreatmentId = treatmentDropdown.value;

                // Boş bir seçim yapıldıysa çalışan listesini temizle
                if (!selectedTreatmentId) {
                    fillEmployeeDropdown([]);
                    return;
                }

                try {
                    // API çağrısı yapar
                    const response = await fetch(`/Employees/Skills/${selectedTreatmentId}`);
                    if (!response.ok) {
                        throw new Error("Error fetching employees");
                    }

                    const employees = await response.json();

                    // Çalışan listesi dolduruluyor
                    fillEmployeeDropdown(employees);
                } catch (error) {
                    console.error("Failed to fetch employees:", error);
                    fillEmployeeDropdown([]);
                }
            });

            function fillEmployeeDropdown(employees) {
                // Employee dropdown'ını temizler
                employeeDropdown.innerHTML = '';

                if (employees.length === 0) {
                    // Çalışan bulunamadığında bir mesaj gösterir
                    const noOption = document.createElement('option');
                    noOption.text = "No employees available";
                    noOption.value = '';
                    employeeDropdown.appendChild(noOption);
                    return;
                }

                // Gelen çalışanları dropdown'a ekler
                employees.forEach(employee => {
                    const option = document.createElement('option');
                    option.value = employee.employeeID;
                    option.text = employee.employeeName;
                    employeeDropdown.appendChild(option);
                });
            }
        });

    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}