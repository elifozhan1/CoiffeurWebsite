@model IEnumerable<CoiffeurWebsite.Models.Appointment>

<h2>My Appointments</h2>
<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Employee</th>
            <th>Treatment</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var appointment in Model)
        {
            <tr>
                <td>@appointment.AppointmentDate.ToShortDateString()</td>
                <td>@appointment.AppointmentDate.ToShortTimeString()</td>
                <td>@appointment.Employee.EmployeeName</td>
                <td>@appointment.Treatment.TreatmentName</td>
                <td>@appointment.Status</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-secondary">Create An Appointment</a>